def display(processes, gantt, timeline):

    print("\nGantt Chart:")
    print("|", end="")
    for p in gantt:
        print(f" {p} |", end="")
    print()

    for t in timeline:
        print(t, end="   ")
    print("\n")

    print("Process\tAT\tBT\tPR\tCT\tWT\tTAT")

    total_wt = total_tat = 0

    processes.sort(key=lambda x: x['id'])

    for p in processes:
        tat = p['ct'] - p['at']
        wt = tat - p['bt']

        total_wt += wt
        total_tat += tat

        print(f"{p['id']}\t{p['at']}\t{p['bt']}\t{p['priority']}\t{p['ct']}\t{wt}\t{tat}")

    n = len(processes)
    print("\nAverage WT =", round(total_wt/n,2))
    print("Average TAT =", round(total_tat/n,2))


def priority_p(processes):

    time = 0
    remaining = {p['id']: p['bt'] for p in processes}
    completed = 0
    n = len(processes)

    gantt = []
    timeline = [0]
    last = None

    while completed < n:

        ready = [p for p in processes if p['at'] <= time and remaining[p['id']] > 0]

        if ready:
            p = min(ready, key=lambda x: x['priority'])

            if last != p['id']:
                gantt.append(p['id'])
                timeline.append(time)
                last = p['id']

            remaining[p['id']] -= 1
            time += 1

            if remaining[p['id']] == 0:
                p['ct'] = time
                completed += 1
        else:
            time += 1

    timeline.append(time)

    display(processes, gantt, timeline)

n = int(input("Enter number of processes: "))
processes = []

for i in range(n):
    at = int(input("AT: "))
    bt = int(input("BT: "))
    pr = int(input("Priority: "))
    processes.append({'id': f'P{i+1}', 'at': at, 'bt': bt, 'priority': pr})

priority_p(processes)
