def display(processes, gantt, timeline):

    print("\nGantt Chart:")
    print("|", end="")
    for p in gantt:
        print(f" {p} |", end="")
    print()

    for t in timeline:
        print(t, end="   ")
    print("\n")

    print("Process\tAT\tBT\tPR\tCT\tWT\tTAT")

    total_wt = total_tat = 0

    processes.sort(key=lambda x: x['id'])

    for p in processes:
        tat = p['ct'] - p['at']
        wt = tat - p['bt']

        total_wt += wt
        total_tat += tat

        print(f"{p['id']}\t{p['at']}\t{p['bt']}\t{p['priority']}\t{p['ct']}\t{wt}\t{tat}")

    n = len(processes)
    print("\nAverage WT =", round(total_wt/n,2))
    print("Average TAT =", round(total_tat/n,2))

def priority_np(processes):

    time = 0
    completed = 0
    n = len(processes)

    gantt = []
    timeline = [0]

    while completed < n:

        ready = [p for p in processes if p['at'] <= time and 'ct' not in p]

        if ready:
            p = min(ready, key=lambda x: x['priority'])

            gantt.append(p['id'])
            time += p['bt']
            p['ct'] = time
            timeline.append(time)

            completed += 1
        else:
            time += 1

    display(processes, gantt, timeline)

n = int(input("Enter number of processes: "))
processes = []

for i in range(n):
    at = int(input("AT: "))
    bt = int(input("BT: "))
    pr = int(input("Priority: "))
    processes.append({'id': f'P{i+1}', 'at': at, 'bt': bt, 'priority': pr})

priority_np(processes)
